# Optional: override workspace/runtime locations. If unset, the app uses
# ./data and ./runtime inside the project directory, created automatically.
# VASP_STUDIO_WORKSPACE_ROOT=/home/your-user/.local/share/vasp-input-studio/workspace
# VASP_STUDIO_RUNTIME_DIR=/home/your-user/.local/state/vasp-input-studio/runtime

# Optional direct-submit integration
# VASP_STUDIO_VASP_ENV_SCRIPT=/home/your-user/vasp-env.sh
# VASP_STUDIO_VASPKIT_CMD=/usr/local/bin/vaspkit
# VASP_STUDIO_POTCAR_ARCHIVE_PBE_64=/path/to/POTCAR_PBE_64.tar.gz

# Optional AiiDA integration
VASP_STUDIO_ENABLE_AIIDA_BACKEND=0
# VASP_STUDIO_AIIDA_PROFILE_NAME=vasp_studio_pg
